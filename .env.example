# Base URL for tests
BASE_URL=https://example.com

# Test user credentials (Get from GitHub Secrets in CI/CD)
TEST_EMAIL=user@example.com
TEST_USERNAME=testuser
TEST_PASSWORD=testpassword

# Smartest QA specific settings
SMARTEST_QA_URL=https://demo.smartestqa.online
SMARTEST_QA_LOGIN_URL=https://demo.smartestqa.online/login
SMARTEST_QA_COMPANY=Selenity Technology
SMARTEST_QA_PROJECT=ExampleProjectSmartest

# Test environment
TEST_ENV=staging

# Timeouts (in milliseconds)
ACTION_TIMEOUT=10000
NAVIGATION_TIMEOUT=30000

# Browser settings
HEADLESS=true
SLOW_MO=0

# CI/CD settings
CI=false

# Dashboard specific settings
DASHBOARD_URL=https://example.com/dashboard
LOGIN_URL=https://example.com/login

